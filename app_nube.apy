import streamlit as st
import gspread
from google.oauth2.service_account import Credentials

st.title("☁️ Mi Aplicación en la Nube")

# PEGA AQUÍ TU ENLACE REAL DE GOOGLE SHEETS ENTRE LAS COMILLAS
URL_HOJA = "PEGA_AQUÍ_TU_ENLACE"

try:
    # 1. Cargar las credenciales desde la caja fuerte de Streamlit Cloud
    cred_dict = dict(st.secrets["gcp_service_account"])
    scopes = ['https://www.googleapis.com/auth/spreadsheets', 'https://www.googleapis.com/auth/drive']
    credentials = Credentials.from_service_account_info(cred_dict, scopes=scopes)
    gc = gspread.authorize(credentials)
    
    # 2. Conectar a la hoja y escribir un saludo
    hoja = gc.open_by_url(URL_HOJA)
    pestana = hoja.sheet1
    pestana.update_acell('A1', '¡Hola desde Streamlit Cloud!')
    
    st.success("✅ ¡Conectado a Google Sheets desde la nube con éxito!")
    st.info("🎉 Ve a tu Google Sheets y comprueba que ha aparecido el saludo en la celda A1.")
    
except Exception as e:
    st.error("❌ Error de conexión:")
    st.code(e)
